  --admin-card-green:  #cfe6a8;
  --admin-card-amber:  #f3dba3;
  --admin-card-blue:   #aed6e8;
  --admin-card-red:    #f2b3ad;
  --admin-border:      rgba(0,0,0,0.08);
}

.admin-root, .admin-root * { box-sizing: border-box; }
.admin-root {
  font-family: var(--ff-body);
  min-height: 100vh;
}

/* ── LOGIN PAGE ── */
.admin-login-shell {
  min-height: 100vh;
  background: var(--admin-navy);
  padding: 28px;
}
.admin-login-card {
  background: #fff;
  min-height: calc(100vh - 56px);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.admin-login-box {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 360px;
  text-align: center;
  padding: 24px;
}
.admin-login-box h1 {
  font-family: var(--ff);
  font-weight: 800;
  font-size: 1.7rem;
  color: #1a1a1a;
  margin-bottom: 6px;
}
.admin-login-box p {
  color: #555;
  margin-bottom: 28px;
}
.admin-login-field {
  margin-bottom: 16px;
  text-align: left;
}
.admin-login-field input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #b9b9b9;
  background: #fcfaf6;
  border-radius: 2px;
  font-size: 0.95rem;
  font-family: var(--ff-body);
}
.admin-login-field input:focus {
  outline: 2px solid var(--admin-navy);
  outline-offset: 1px;
}
.admin-login-field input::placeholder { color: #6b6b6b; }
.admin-login-error {
  color: var(--admin-status-danger);
  font-size: 0.85rem;
  margin: -8px 0 14px;
  text-align: left;
}
.admin-login-submit {
  margin-top: 12px;
  width: 100%;
  max-width: 200px;
  padding: 0.85rem 1.5rem;
  background: var(--admin-navy);
  color: #fff;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  letter-spacing: 0.03em;
  cursor: pointer;
  transition: background 0.2s ease;
}
.admin-login-submit:hover { background: var(--admin-navy-dark); }
.admin-login-watermark {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.12;
  filter: grayscale(1);
  pointer-events: none;
}
.admin-login-watermark img { width: 480px; max-width: 70vw; }

/* ── LAYOUT SHELL ── */
.admin-page {
  min-height: 100vh;
  background: #eef1f3;
  display: flex;
  flex-direction: column;
  padding: 14px;
}
.admin-topbar {
  display: flex;
  flex-shrink: 0;
  border-radius: 14px 14px 0 0;
  overflow: hidden;
  border-bottom: 2px solid rgba(255, 255, 255, 0.85);
}
.admin-topbar-brand {
  width: 264px;
  flex-shrink: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16px 16px;
  border-right: 1px solid var(--admin-border);
}
.admin-topbar-fill {
  flex: 1;
  background: var(--admin-navy);
}
.admin-shell {
  display: flex;
  flex: 1;
  min-height: 0;
  background: var(--admin-navy);
  border-radius: 0 0 14px 14px;
  overflow: hidden;
}

.admin-sidebar {
  width: 264px;
  flex-shrink: 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  padding: 22px 0 18px;
  border-radius: 0 0 0 14px;
}
.admin-sidebar-logo {
  display: flex;
  align-items: center;
  gap: 8px;
}
.admin-sidebar-logo img { width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0; }
.admin-sidebar-logo span {
  font-family: var(--ff);
  font-weight: 800;
  font-size: 0.78rem;
  color: var(--admin-navy);
  letter-spacing: 0.01em;
  white-space: nowrap;
  line-height: 1.2;
}

.admin-nav { flex: 1; overflow-y: auto; padding-top: 4px; }

.admin-nav-group { margin-bottom: 2px; }

.admin-nav-toplink, .admin-nav-grouptoggle {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  background: none;
  border: none;
  text-align: left;
  padding: 11px 20px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: var(--admin-sidebar-text);
  cursor: pointer;
  position: relative;
}
.admin-nav-toplink.active,
.admin-nav-grouptoggle.has-active {
  color: var(--admin-sidebar-active);
}
.admin-nav-toplink.active::before,
.admin-nav-group.has-active > .admin-nav-grouptoggle::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4px;
  background: var(--admin-sidebar-active);
}
.admin-nav-icon {
  flex-shrink: 0;
  width: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}
.admin-nav-caret {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  opacity: 0.6;
  color: currentColor;
  transition: transform 0.15s ease;
}
.admin-nav-grouptoggle[aria-expanded="true"] .admin-nav-caret { transform: rotate(180deg); }

.admin-nav-sublist { padding-left: 0; }
.admin-nav-sublink {
  display: block;
  padding: 8px 20px 8px 48px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #8a9499;
  position: relative;
}
.admin-nav-sublink:hover { color: var(--admin-navy); }
.admin-nav-sublink.active {
  color: var(--admin-sidebar-active);
}
.admin-nav-sublink.active::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4px;
  background: var(--admin-sidebar-active);
}

.admin-sidebar-footer { padding: 18px 20px 0; margin-top: auto; }
.admin-logout-btn {
  width: 100%;
  background: var(--admin-navy);
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 12px;
  font-weight: 700;
  letter-spacing: 0.03em;
  cursor: pointer;
  transition: background 0.2s ease;
}
.admin-logout-btn:hover { background: var(--admin-navy-dark); }

/* ── MAIN CONTENT AREA ── */
.admin-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.admin-content {
  flex: 1;
  padding: 28px 36px 48px;
  position: relative;
}
.admin-content::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 100% 0%, rgba(255,255,255,0.04), transparent 60%);
  pointer-events: none;
}

.admin-page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
}
.admin-page-head h1 {
  font-family: var(--ff);
  font-weight: 800;
  font-size: 2.1rem;
  color: #fff;
  min-width: 0;
}
.admin-userchip {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border-radius: 8px;
  padding: 8px 16px 8px 8px;
  flex-shrink: 0;
}
.admin-userchip-avatar {
  width: 42px; height: 42px;
  border-radius: 50%;
  background: #e8924f;
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
}
.admin-userchip-name { font-weight: 700; color: var(--admin-navy); font-size: 0.92rem; line-height: 1.2; }
.admin-userchip-role { color: #777; font-size: 0.8rem; }

/* ── STAT CARDS ── */
.admin-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 28px;
  position: relative;
  z-index: 1;
}
.admin-stat-card {
  background: #fff;
  border-radius: 8px;
  padding: 18px 20px;
}
.admin-stat-card.tone-green  { background: var(--admin-card-green); }
.admin-stat-card.tone-amber  { background: var(--admin-card-amber); }
.admin-stat-card.tone-blue   { background: var(--admin-card-blue); }
.admin-stat-card.tone-red    { background: var(--admin-card-red); }
.admin-stat-label { color: var(--admin-navy); font-weight: 600; font-size: 0.95rem; margin-bottom: 6px; }
.admin-stat-card.tone-red .admin-stat-label { color: #8c2c22; }
.admin-stat-value { font-family: var(--ff); font-weight: 800; font-size: 2.6rem; color: var(--admin-navy); }
.admin-stat-card.tone-red .admin-stat-value { color: #c0392b; }

/* ── PANELS (Recent Activity / Notifications) ── */
.admin-panel-grid {
  display: grid;
  grid-template-columns: 2.2fr 1fr;
  gap: 22px;
  position: relative;
  z-index: 1;
}
.admin-panel h2 {
  color: #fff;
  font-weight: 700;
  font-size: 1.05rem;
  margin-bottom: 10px;
  padding-bottom: 10px;
  border-bottom: 2px solid rgba(255,255,255,0.4);
}
.admin-panel-box {
  background: #fff;
  border-radius: 8px;
  min-height: 380px;
  padding: 6px;
}
.admin-panel-empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa3a7;
  font-size: 0.9rem;
  min-height: 360px;
  text-align: center;
  padding: 24px;
}

/* ── SEARCH BAR ── */
.admin-searchbar {
  position: relative;
  z-index: 1;
  margin-bottom: 22px;
  max-width: 480px;
}
.admin-searchbar input {
  width: 100%;
  padding: 13px 18px 13px 44px;
  border: none;
  border-radius: 24px;
  background: #fff;
  font-size: 0.92rem;
  color: #333;
}
.admin-searchbar input::placeholder { color: #9aa3a7; }
.admin-searchbar input:focus { outline: 2px solid #fff; outline-offset: 2px; }
.admin-searchbar-icon {
  position: absolute;
  left: 16px; top: 50%;
  transform: translateY(-50%);
  color: #9aa3a7;
  pointer-events: none;
}

.admin-pill-action-btn {
  background: #4f93b8;
  color: #fff;
  border: none;
  border-radius: 24px;
  padding: 13px 24px;
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s ease;
}
.admin-pill-action-btn:hover { background: #3f7d9f; }

.admin-searchbar-row {
  display: flex;
  gap: 12px;
  margin-bottom: 22px;
  align-items: center;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}
.admin-searchbar-flex { margin-bottom: 0; flex: 1; min-width: 200px; }

.admin-edit-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.95rem;
  color: #6b7780;
  padding: 4px;
}
.admin-edit-btn:hover { color: var(--admin-navy); }

/* ── REPORTS PAGE CONTROLS ── */
.admin-report-controls {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr auto;
  gap: 16px;
  align-items: end;
  margin-bottom: 22px;
  position: relative;
  z-index: 1;
}
.admin-report-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.admin-report-field label {
  color: #fff;
  font-weight: 700;
  font-size: 0.82rem;
  background: var(--admin-table-head);
  padding: 8px 14px;
  border-radius: 6px 6px 0 0;
}
.admin-report-field select,
.admin-report-field input {
  padding: 12px 14px;
  border: none;
  border-radius: 0 0 6px 6px;
  background: #fff;
  font-size: 0.88rem;
  color: #333;
}
.admin-report-field select:focus,
.admin-report-field input:focus { outline: 2px solid #fff; outline-offset: 1px; }
.admin-generate-btn { padding: 14px 28px; }

/* ── TABLES ── */
.admin-table-wrap {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
}
.admin-table-scroll {
  overflow-x: auto;
}
table.admin-table { width: 100%; min-width: 600px; border-collapse: collapse; }
.admin-table thead th {
  background: var(--admin-table-head);
  color: #fff;
  text-align: left;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 14px 16px;
  white-space: nowrap;
}
.admin-table tbody td {
  padding: 16px;
  border-bottom: 1px solid var(--admin-border);
  font-size: 0.88rem;
  color: #333;
  vertical-align: middle;
}
.admin-table tbody tr:last-child td { border-bottom: none; }
.admin-table tbody tr:hover { background: #f7fafc; cursor: default; }
.admin-table tbody tr.is-clickable:hover { cursor: pointer; background: #eef6fb; }
.admin-table-name { font-weight: 700; color: #1a1a1a; }
.admin-table-sub { color: #8a9499; font-size: 0.8rem; }
.admin-table-empty-row td {
  text-align: center;
  color: #9aa3a7;
  padding: 48px 16px;
}

/* ── STATUS PILLS ── */
.admin-pill {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 14px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  text-align: center;
  line-height: 1.3;
}
.admin-pill-pending { background: var(--admin-status-pending-bg); color: var(--admin-status-pending-text); }
.admin-pill-active  { background: var(--admin-status-active-bg); color: var(--admin-status-active-text); }
.admin-pill-rejected { background: #f2b3ad; color: #7a261c; }
.admin-pill-complete { background: #b7dd8f; color: #355e1a; }
.admin-pill-open { background: #f0935a; color: #ffffff; }
.admin-pill-resolved { background: #aed6e8; color: #0d4f66; }
.admin-pill-neutral { background: #d6dadc; color: #5a6268; }

/* ── ACTION ICON BUTTONS (approve/reject) ── */
.admin-action-group { display: flex; gap: 8px; }
.admin-icon-btn {
  width: 30px; height: 30px;
  border-radius: 4px;
  border: none;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  color: #fff;
  font-size: 0.85rem;
}
.admin-icon-btn.approve { background: #5cb85c; }
.admin-icon-btn.approve:hover { background: #4a9d4a; }
.admin-icon-btn.reject { background: #d9534f; }
.admin-icon-btn.reject:hover { background: #c9302c; }
.admin-icon-btn:disabled { opacity: 0.45; cursor: not-allowed; }

.admin-file-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--admin-navy);
  font-weight: 600;
  font-size: 0.85rem;
}
.admin-doc-icon { color: #6b7780; cursor: pointer; }

/* ── DONOR PROFILE SIDE PANEL ── */
.admin-with-panel { display: flex; gap: 22px; align-items: flex-start; }
.admin-with-panel > .admin-table-wrap { flex: 1; min-width: 0; }
.admin-side-panel {
  width: 320px;
  flex-shrink: 0;
  background: #f6f1e7;
  border-radius: 8px;
  position: relative;
  z-index: 1;
}
.admin-side-panel-head {
  background: var(--admin-navy);
  color: #fff;
  font-weight: 700;
  padding: 14px 18px;
  border-radius: 8px 8px 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.admin-side-panel-close {
  background: none; border: none; color: #fff; cursor: pointer; font-size: 1rem; line-height: 1;
}
.admin-side-panel-body { padding: 18px 18px 22px; font-size: 0.88rem; color: #333; }
.admin-side-panel-body h3 {
  font-weight: 700;
  margin: 14px 0 6px;
  font-size: 0.92rem;
  color: #1a1a1a;
}
.admin-side-panel-body h3:first-child { margin-top: 0; }
.admin-side-panel-body p { margin-bottom: 2px; line-height: 1.5; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .admin-shell { flex-direction: column; }
  .admin-sidebar { width: 100%; }
  .admin-topbar-brand { width: 100%; border-right: none; }
  .admin-topbar-fill { display: none; }
  .admin-stat-grid { grid-template-columns: repeat(2, 1fr); }
  .admin-panel-grid { grid-template-columns: 1fr; }
  .admin-with-panel { flex-direction: column; }
  .admin-side-panel { width: 100%; }
  .admin-report-controls { grid-template-columns: 1fr 1fr; }
  .admin-generate-btn { grid-column: 1 / -1; }
}

@media (max-width: 520px) {
  .admin-content { padding: 20px 16px 36px; }
  .admin-page-head h1 { font-size: 1.5rem; }
  .admin-userchip { padding: 6px 12px 6px 6px; }
  .admin-userchip-avatar { width: 34px; height: 34px; font-size: 0.8rem; }
  .admin-userchip-name { font-size: 0.82rem; }
  .admin-userchip-role { font-size: 0.72rem; }
  .admin-stat-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  .admin-stat-value { font-size: 2rem; }
  .admin-report-controls { grid-template-columns: 1fr; }
  .admin-generate-btn { grid-column: auto; }
  .admin-searchbar { max-width: none; }
  .admin-searchbar-row { flex-direction: column; align-items: stretch; }
  .admin-searchbar-flex { min-width: 0; }
}
</file>

