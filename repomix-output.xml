import { Routes, Route } from 'react-router-dom';
import PublicLayout from './public-site/layouts/PublicLayout';
import HomePage from './public-site/pages/HomePage';
import DonateForm from './public-site/pages/DonateForm';
import AboutUs from './public-site/pages/AboutUs';
import WhoWeHelp from './public-site/pages/WhoWeHelp';
import MilkyWay from './public-site/pages/MilkyWay';
import SupsupTodo from './public-site/pages/SupsupTodo';
import MomsAct from './public-site/pages/MomsAct';
import Procedure from './public-site/pages/Procedure';
import Process from './public-site/pages/Process';
import Safety from './public-site/pages/Safety';

import AdminLayout from './admin/layouts/AdminLayout';
import Login from './admin/pages/Login';
import Dashboard from './admin/pages/Dashboard';
import Applicants from './admin/pages/Applicants';
import Donors from './admin/pages/Donors';
import Collections from './admin/pages/Collections';
import Laboratory from './admin/pages/Laboratory';
import Pasteurization from './admin/pages/Pasteurization';
import Inventory from './admin/pages/Inventory';
import Beneficiaries from './admin/pages/Beneficiaries';
import Dispensing from './admin/pages/Dispensing';
import Hotline from './admin/pages/Hotline';
import Reports from './admin/pages/Reports';
import UserManagement from './admin/pages/UserManagement';

function App() {
  return (
    <Routes>
      {/* Public site */}
      <Route element={<PublicLayout />}>
        <Route path="/" element={<HomePage />} />
        <Route path="/donate" element={<DonateForm />} />
        <Route path="/about" element={<AboutUs />} />
        <Route path="/who" element={<WhoWeHelp />} />
        <Route path="/milky-way" element={<MilkyWay />} />
        <Route path="/supsup-todo" element={<SupsupTodo />} />
        <Route path="/moms-act" element={<MomsAct />} />
        <Route path="/procedure" element={<Procedure />} />
        <Route path="/process" element={<Process />} />
        <Route path="/safety" element={<Safety />} />
      </Route>

      {/* Admin Panel */}
      <Route path="/admin/login" element={<Login />} />
      <Route path="/admin" element={<AdminLayout />}>
        <Route path="dashboard" element={<Dashboard />} />
        <Route path="donor-management/applicants" element={<Applicants />} />
        <Route path="donor-management/donors" element={<Donors />} />
        <Route path="donor-management/collections" element={<Collections />} />
        <Route path="processing/laboratory" element={<Laboratory />} />
        <Route path="processing/pasteurization" element={<Pasteurization />} />
        <Route path="processing/inventory" element={<Inventory />} />
        <Route path="beneficiaries/list" element={<Beneficiaries />} />
        <Route path="beneficiaries/dispensing" element={<Dispensing />} />
        <Route path="support/hotline" element={<Hotline />} />
        <Route path="reports" element={<Reports />} />
        <Route path="administration/user-management" element={<UserManagement />} />
      </Route>
    </Routes>
  );
}

export default App;
</file>

<file path="src/style.css">
/* ════════════════════════════════
   HOMEPAGE STYLES
════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Open+Sans:wght@400;600&display=swap');

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --blue:         #4497c1;
  --blue-mid:     #1873b8;
  --blue-dark:    #005482;
  --blue-navy:    #0049a4;
  --blue-grad:    radial-gradient(circle at 50% 50%, #4497c1, #21527e);
  --hover-red:    #d7513b;
  --text:         #545454;
  --text-strong:  #005482;
  --white:        #ffffff;
  --off:          #f4f8fc;
  --border:       rgba(0,0,0,0.09);
  --max:          100%;
  --ff:           'Montserrat', sans-serif;
  --ff-body:      'Open Sans', sans-serif;
}

html { scroll-behavior: smooth; }
body { font-family: var(--ff-body); color: var(--text); background: var(--white); overflow-x: hidden; line-height: 1.6; }
a { color: inherit; text-decoration: none; }

/* ════════════════════
   NAVBAR
════════════════════ */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--white);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.nav-inner {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 2rem;
  height: 88px;
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

/* Logo */
.nav-logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.nav-logo-img { height: 90px; width: auto; display: block; border-radius: 100px;}

/* Links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 0;
  margin-left: auto;
}
.nav-links > a,
.nav-drop-btn {
  font-family: var(--ff);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text);
  padding: 0.5rem 1rem;
  border: none;
  background: none;
  cursor: pointer;
  white-space: nowrap;
  transition: color 0.15s;
}
.nav-links > a:hover, .nav-drop-btn:hover { color: var(--hover-red); }
.caret { font-size: 10px; }

/* Dropdown */
.nav-dropdown { position: relative; }
.dropdown-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  min-width: 200px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 6px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  padding: 6px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-6px);
  transition: opacity 0.18s, transform 0.18s;
}
.nav-dropdown:hover .dropdown-menu,
.nav-dropdown:focus-within .dropdown-menu {
  opacity: 1;
  pointer-events: all;
  transform: translateY(0);
}
.dropdown-menu a {
  display: block;
  font-family: var(--ff);
  font-size: 12px;
  font-weight: 600;
  padding: 9px 14px;
  border-radius: 4px;
  color: var(--text);
  transition: background 0.13s;
}
.dropdown-menu a:hover { background: #e8f0eb; color: var(--hover-red); }

/* Donate btn */
.btn-nav-donate {
  background: var(--blue);
  color: #fff;
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.65rem 1.6rem;
  border-radius: 4px;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.15s;
}
.btn-nav-donate:hover { background: var(--blue-dark); }

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  margin-left: auto;
}
.hamburger span { display: block; width: 24px; height: 2px; background: var(--text); border-radius: 2px; transition: transform 0.25s, opacity 0.25s; }
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Mobile menu */
.mobile-menu { display: none; flex-direction: column; background: var(--white); border-top: 1px solid var(--border); padding: 1rem 1.5rem 1.5rem; gap: 0.25rem; }
.mobile-menu.open { display: flex; }
.mobile-menu a { font-family: var(--ff); font-size: 14px; font-weight: 600; color: var(--text); padding: 0.65rem 0; border-bottom: 1px solid var(--border); }
.mobile-donate-link { margin-top: 0.5rem !important; background: var(--blue-mid) !important; color: #fff !important; text-align: center; padding: 0.85rem !important; border-radius: 4px; border-bottom: none !important; }

/* Mobile Submenu Styling */
.mobile-submenu {
  display: flex;
  flex-direction: column;
  background: #f8fbf9;
  padding-left: 1.5rem;
  border-bottom: 1px solid var(--border);
}

.mobile-submenu a {
  border-bottom: none;
  padding: 0.5rem 0;
  font-size: 13px;
  color: #555;
}

.mobile-submenu a:last-child {
  padding-bottom: 0.85rem;
}

/* ════════════════════
   HERO
════════════════════ */
.hero {
  position: relative;
  height: 520px;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: 1fr 1.5fr 1fr;
  gap: 2px;
}
.hero-img {
  background-size: cover;
  background-position: center;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.55) 100%);
}
.hero-content {
  position: absolute;
  bottom: 3rem;
  left: 3rem;
  z-index: 2;
  max-width: 540px;
}
.hero-content h1 {
  font-family: var(--ff);
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 0.5rem;
}
.hero-content p {
  font-size: 15px;
  color: rgba(255,255,255,0.85);
  font-style: italic;
  line-height: 1.4;
}

/* ════════════════════
   MAIN SECTION (Report + Sidebar)
════════════════════ */
.main-section {
  background: var(--off);
  padding: 3rem 5rem 3.5rem;
}
.main-layout {
  max-width: var(--max);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 2.5rem;
  align-items: stretch;
}

/* ── Report Card ── */
.report-card {
  background: var(--blue-grad);
  border-radius: 12px;
  padding: 2.25rem 2.75rem 2.5rem;
  color: #fff;
}
.report-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}
.report-line {
  width: 60px;
  height: 2px;
  background: rgba(255,255,255,0.6);
  flex-shrink: 0;
}
.report-title {
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.85);
  font-style: italic;
}
.report-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  margin-bottom: 1.5rem;
}
.total-num {
  font-family: var(--ff);
  font-size: clamp(5rem, 12vw, 8rem);
  font-weight: 900;
  line-height: 1;
  color: #fff;
  letter-spacing: -0.02em;
}
.total-label {
  font-family: var(--ff);
  font-size: 18px;
  font-weight: 600;
  color: rgba(255,255,255,0.9);
}
.report-divider {
  height: 1px;
  background: rgba(255,255,255,0.25);
  margin-bottom: 1.75rem;
}
.report-sub-stats {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  gap: 0;
  align-items: center;
}
.sub-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.35rem;
  padding: 0 1rem;
}
.sub-num {
  font-family: var(--ff);
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  font-weight: 900;
  color: #fff;
  line-height: 1;
}
.sub-label {
  font-family: var(--ff);
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.8);
  text-align: center;
  line-height: 1.35;
}
.sub-sep {
  width: 1px;
  height: 60px;
  background: rgba(255,255,255,0.25);
  flex-shrink: 0;
}

/* ── Sidebar ── */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.sidebar-card {
  background: var(--white);
  border-radius: 10px;
  padding: 1.75rem 1.5rem;
  text-align: center;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
}
.sidebar-icon svg {
  width: 64px;
  height: 64px;
  margin: 0 auto 0.9rem;
  display: block;
}
.sidebar-name {
  font-family: var(--ff);
  font-size: 16px;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 0.35rem;
}
.sidebar-address {
  font-size: 13px;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 0.4rem;
}
.sidebar-hours {
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 1rem;
}
.sidebar-phone {
  font-family: var(--ff);
  font-size: 17px;
  font-weight: 800;
  color: var(--blue);
  margin-top: 0.5rem;
}
.btn-map {
  display: inline-block;
  background: var(--blue);
  color: #fff;
  font-family: var(--ff);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 0.6rem 1.1rem;
  border-radius: 4px;
  transition: background 0.15s;
}
.btn-map:hover { background: var(--blue-dark); }

/* ════════════════════
   DONATION SERVICES
════════════════════ */
.services {
  padding: 3.5rem 5rem 4rem;
  background: var(--white);
}
.services-inner { max-width: var(--max); margin: 0 auto; }
.services-header { margin-bottom: 2rem; }
.services-header h2 {
  font-family: var(--ff);
  font-size: clamp(1.6rem, 3vw, 2.25rem);
  font-weight: 900;
  color: var(--blue);
  margin-bottom: 0.6rem;
}
.services-rule {
  width: 60%;
  height: 0.5px;
  background: var(--blue-navy);
}
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 2rem;
}
.service-card {
  background: var(--blue);
  border-radius: 10px;
  padding: 3rem 1.5rem 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  outline: none;
}
.service-card:hover, .service-card:focus {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(28,111,171,0.3);
}
.service-icon svg { width: 90px; height: 90px; }
.service-card h3 {
  font-family: var(--ff);
  font-size: 18px;
  font-weight: 900;
  color: #fff;
  letter-spacing: 0.05em;
  text-align: center;
}
.service-card p {
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  text-align: center;
  letter-spacing: 0.02em;
}

/* ════════════════════
   DONATION FORM
════════════════════ */

.section-title-line {
  font-family: var(--ff);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--blue);
  border-bottom: 2px solid var(--blue);
  padding-bottom: 8px;
  margin-bottom: 15px;
}

.section-subtitle {
  font-family: var(--ff);
  font-size: 0.95rem;
  color: #555;
  font-style: italic;
  margin-bottom: 20px;
}

/* Medical & Lifestyle */
.medical-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}
.medical-table th {
  text-align: center;
  font-size: 0.9rem;
  color: #333;
  padding-bottom: 10px;
}
.medical-table td {
  padding: 12px 10px;
  border-bottom: 1px solid #f0f0f0;
  color: #444;
  font-size: 0.95rem;
  line-height: 1.5;
}
.medical-table td:nth-child(2),
.medical-table td:nth-child(3) {
  text-align: center;
  width: 60px;
}

/* Donating Breast Milk */
.mcq-list {
  display: flex;
  flex-direction: column;
  gap: 25px;
}
.mcq-question {
  font-size: 0.95rem;
  font-weight: 600;
  color: #444;
  margin-bottom: 5px;
}
.mcq-subtext {
  font-size: 0.85rem;
  color: #777;
  font-style: italic;
  margin-bottom: 10px;
}
.mcq-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-left: 15px;
}
.mcq-label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
}
.mcq-label input[type="radio"] {
  margin-top: 4px;
}
.mcq-text {
  font-size: 0.95rem;
  color: #555;
  line-height: 1.4;
}

/* Date/Time */
.datetime-field {
  padding-left: 15px;
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 15px;
}
.datetime-field label {
  font-size: 0.95rem;
  color: #555;
}
.datetime-field input {
  padding: 8px 12px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-family: inherit;
}

/* Consent Section */
.consent-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 10px 0;
}
.consent-label {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
}
.consent-label input[type="checkbox"] {
  margin-top: 5px;
  width: 16px;
  height: 16px;
  accent-color: var(--blue);
}
.consent-text {
  font-size: 0.95rem;
  color: #555;
  line-height: 1.6;
}
.consent-text strong {
  color: #333;
}

/* ════════════════════
   ABOUT
════════════════════ */
.about { background: var(--off); padding: 5rem 2rem; }
.about-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.section-eyebrow {
  display: inline-block;
  font-family: var(--ff);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 0.75rem;
  border-left: 3px solid var(--blue);
  padding-left: 10px;
}
.eyebrow-light { color: rgba(255,255,255,0.65); border-color: rgba(255,255,255,0.4); }
.about-text h2 {
  font-family: var(--ff);
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  font-weight: 900;
  color: var(--text);
  line-height: 1.2;
  margin-bottom: 1.25rem;
}
.about-text p { font-size: 14.5px; color: var(--text); margin-bottom: 1rem; line-height: 1.7; }
.about-text p strong { color: var(--text); }
.btn-blue {
  display: inline-block;
  margin-top: 0.5rem;
  background: var(--blue);
  color: #fff;
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.06em;
  padding: 0.75rem 1.75rem;
  border-radius: 4px;
  transition: background 0.15s;
}
.btn-blue:hover { background: var(--blue-dark); }
.about-img {
  border-radius: 10px;
  aspect-ratio: 4/3;
  background-size: cover;
  background-position: center;
  box-shadow: 0 12px 40px rgba(0,0,0,0.12);
}

/* ════════════════════
   WHO WE HELP
════════════════════ */
.who { background: var(--blue-grad); padding: 5rem 2rem; }
.who-inner { max-width: var(--max); margin: 0 auto; }
.who-inner h2 {
  font-family: var(--ff);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 900;
  color: #fff;
  margin-bottom: 2.5rem;
}
.who-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}
.who-card {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  padding: 1.5rem;
  transition: background 0.2s;
}
.who-card:hover { background: rgba(255,255,255,0.14); }
.who-num {
  font-family: var(--ff);
  font-size: 28px;
  font-weight: 900;
  color: rgba(255,255,255,0.2);
  line-height: 1;
  margin-bottom: 0.75rem;
}
.who-card h4 {
  font-family: var(--ff);
  font-size: 14px;
  font-weight: 800;
  color: #fff;
  margin-bottom: 0.5rem;
  line-height: 1.3;
}
.who-card p { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.6; }

/* ════════════════════
   CTA STRIP
════════════════════ */
.cta-strip { background: var(--blue-dark); padding: 2.25rem 2rem; }
.cta-strip-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.cta-strip p {
  font-family: var(--ff);
  font-size: 16px;
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  flex: 1;
}
.btn-white {
  display: inline-block;
  background: #fff;
  color: var(--blue-dark);
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.06em;
  padding: 0.8rem 2rem;
  border-radius: 4px;
  white-space: nowrap;
  transition: background 0.15s;
}
.btn-white:hover { background: #e8f2fb; }

/* ════════════════════
   QUOTE BLOCK
════════════════════ */
.quote-block {
  background: #fff;
  padding: 5rem 5rem;
}
.quote-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: flex;
  gap: 0;
  align-items: stretch;
}
.quote-bar {
  width: 5px;
  background: var(--blue);
  border-radius: 3px;
  flex-shrink: 0;
  margin-right: 2rem;
}
.quote-content h2 {
  font-family: var(--ff);
  font-size: clamp(1.8rem, 3.5vw, 2.75rem);
  font-weight: 900;
  color: var(--text-strong);
  line-height: 1.15;
  margin-bottom: 1.25rem;
}
.quote-content p {
  font-family: var(--ff);
  font-size: clamp(14px, 1.4vw, 17px);
  font-weight: 400;
  color: var(--text-strong);
  line-height: 1.65;
  max-width: 900px;
}

/* ════════════════════
   FOOTER
════════════════════ */
.footer {
  background: var(--blue-mid);
  padding: 0;
}
.footer-main {
  max-width: var(--max);
  margin: 0 auto;
  padding: 3.5rem 5rem;
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 3rem;
  align-items: start;
}

/* Logo */
.footer-logo-col { display: flex; align-items: flex-start; }
.footer-logo-img {
  width: 130px;
  height: auto;
  border-radius: 100px;
}

/* Contact info */
.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.footer-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}
.contact-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  margin-top: 2px;
}
.contact-name {
  font-family: var(--ff);
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 2px;
}
.contact-detail {
  font-family: var(--ff);
  font-size: 13.5px;
  font-weight: 500;
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

/* Nav columns */
.footer-nav-col {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.footer-nav-main {
  font-family: var(--ff);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 0.35rem;
  transition: color 0.15s;
}
.footer-nav-main:hover { color: rgba(255,255,255,0.75); }
.footer-nav-sub-group {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  margin-top: 0.25rem;
  padding-left: 0.75rem;
}
.footer-nav-sub-group a {
  font-family: var(--ff);
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.75);
  transition: color 0.15s;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.footer-nav-sub-group a:hover { color: #fff; }

/* Bottom bar */
.footer-bottom {
  background: var(--blue-navy);
  padding: 1.1rem 2rem;
  text-align: center;
}
.footer-bottom p {
  font-family: var(--ff);
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.6);
  letter-spacing: 0.03em;
}

/* ════════════════════
   RESPONSIVE
════════════════════ */
@media (max-width: 1024px) {
  .main-layout { grid-template-columns: 1fr 250px; gap: 1.75rem; }
  .who-grid { grid-template-columns: repeat(2, 1fr); }
  .footer-main { grid-template-columns: auto 1fr; gap: 2rem; }
  .footer-nav-col { grid-column: 1; }
}

@media (max-width: 768px) {
  .nav-links, .btn-nav-donate { display: none; }
  .hamburger { display: flex; }

  .hero { height: 380px; }
  .hero-content { left: 1.5rem; bottom: 2rem; }

  .main-section { padding: 2rem 1.25rem 2.5rem; }
  .main-layout { grid-template-columns: 1fr; }
  .report-card { padding: 1.75rem 1.5rem 2rem; }
  .sub-stat { padding: 0 0.5rem; }

  .services { padding: 2.5rem 1.25rem 3rem; }
  .services-grid { grid-template-columns: 1fr; gap: 1rem; }
  .service-card { padding: 2rem 1.5rem; flex-direction: row; align-items: center; gap: 1.5rem; }
  .service-icon svg { width: 56px; height: 56px; flex-shrink: 0; }
  .service-card h3 { text-align: left; }
  .service-card p { text-align: left; }

  .quote-block { padding: 3rem 1.25rem; }
  .quote-bar { margin-right: 1.25rem; }

  .footer-main { grid-template-columns: 1fr; gap: 2rem; padding: 2.5rem 1.5rem; }
  .footer-logo-img { width: 90px; }
}

@media (max-width: 480px) {
  .hero-bg { grid-template-columns: 1fr 2fr 1fr; }
  .report-sub-stats { grid-template-columns: 1fr; gap: 1.25rem; }
  .sub-sep { display: none; }
  .who-grid { grid-template-columns: 1fr; }
  .service-card { flex-direction: column; text-align: center; }
  .service-card h3, .service-card p { text-align: center; }
  .quote-content h2 { font-size: 1.6rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; }
}

