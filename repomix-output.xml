/* ════ MOM'S ACT PAGE ════ */

.momsact-page-wrapper {
  display: flex;
  flex-direction: column;
}

.momsact-hero {
  background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('/images/image12.png');
  background-size: cover;
  background-position: center;
  padding: 120px 20px;
  text-align: center;
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400px;
}

.momsact-hero-title {
  font-size: 4.5rem;
  font-weight: bold;
  margin-bottom: 5px;
  letter-spacing: 2px;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

.momsact-hero-subtitle {
  font-size: 1.5rem;
  font-weight: normal;
  letter-spacing: 1px;
  max-width: 600px;
  line-height: 1.4;
}

.momsact-content-area {
  background-color: #217dbb; 
  padding: 60px 20px 120px;
  display: flex;
  justify-content: center;
}

.momsact-text-card {
  background-color: white;
  max-width: 800px;
  width: 100%;
  padding: 60px;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  font-size: 1.15rem;
  line-height: 1.8;
  color: #333;
}

/* MOBILE RESPONSIVENESS */
@media (max-width: 768px) {
  .momsact-hero {
    padding: 80px 20px;
    min-height: 300px;
  }

  .momsact-hero-title {
    font-size: 3rem;
  }

  .momsact-hero-subtitle {
    font-size: 1.1rem;
  }

  .momsact-content-area {
    padding: 40px 15px 80px;
  }

  .momsact-text-card {
    padding: 30px 20px;
    font-size: 1rem;
    border-radius: 8px;
  }
}

/* ════════════════════════════════════
   HOW TO DONATE (Procedure/Process/Safety)
══════════════════════════════════════ */

.donate-info-wrapper {
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  min-height: 100vh;
  padding: 80px 20px;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  position: relative;
}

.donate-info-wrapper::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.4);
  z-index: 0;
}

.donate-info-card {
  background: #ffffff;
  max-width: 900px;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
  padding: 60px 80px;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.donate-watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400px;
  height: 400px;
  background-image: url('/src/assets/mhmb-logo.png');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  opacity: 0.05;
  pointer-events: none;
  z-index: -1;
}

.donate-info-header {
  margin-bottom: 50px;
}

.donate-info-header h1 {
  font-family: var(--ff);
  font-size: 3.5rem;
  font-weight: 800;
  color: #115da9;
  border-left: 8px solid #5aa1df;
  padding-left: 20px;
  margin-bottom: 20px;
  line-height: 1;
}

.donate-info-header p {
  font-family: var(--ff);
  font-size: 1.1rem;
  color: #444;
  line-height: 1.6;
}

.donate-info-section {
  margin-bottom: 40px;
}

.donate-info-section h2 {
  font-family: var(--ff);
  font-size: 1.8rem;
  font-weight: 700;
  color: #115da9;
  margin-bottom: 15px;
}

.donate-info-section ol {
  padding-left: 20px;
}

.donate-info-section li {
  font-family: var(--ff);
  font-size: 1rem;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8px;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .donate-info-card {
    padding: 40px 30px;
  }
  
  .donate-info-header h1 {
    font-size: 2.5rem;
    border-left: 6px solid #5aa1df;
    padding-left: 15px;
  }
  
  .donate-info-section h2 {
    font-size: 1.5rem;
  }
  
  .donate-watermark {
    width: 250px;
    height: 250px;
  }
}
